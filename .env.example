# =============================================
# BACKEND ENVIRONMENT VARIABLES
# =============================================

# Database (Aiven MySQL Cloud)
DB_URL=jdbc:mysql://your-host.aivencloud.com:PORT/defaultdb?useSSL=true&requireSSL=true&serverTimezone=UTC&nullCatalogMeansCurrent=true
DB_USERNAME=avnadmin
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-base64-encoded-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Redis (Upstash)
REDIS_HOST=your-redis.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password

# MinIO / File Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=12345678
MINIO_BUCKET_NAME=myphone
MINIO_URL_PREFIX=https://your-backend.onrender.com/api/files

# Mail (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password_16_chars

# CORS - Frontend URL
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================
# FRONTEND ENVIRONMENT VARIABLES
# =============================================
NEXT_PUBLIC_URL=https://your-backend.onrender.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GROQ_API_KEY=gsk_your_groq_api_key
