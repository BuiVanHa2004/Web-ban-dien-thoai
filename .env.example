# =============================================
# BACKEND ENVIRONMENT VARIABLES (LOCAL)
# =============================================

# Database (Local MySQL)
DB_URL=jdbc:mysql://localhost:3306/myphone?useSSL=false&serverTimezone=UTC&nullCatalogMeansCurrent=true
DB_USERNAME=root
DB_PASSWORD=your_local_password

# JWT
JWT_SECRET=your-base64-encoded-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Redis (Local - Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / Backblaze B2 (S3-compatible)
# MinIO / Backblaze B2 (S3-compatible)
# Local MinIO:
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=12345678
MINIO_BUCKET_NAME=myphone
MINIO_REGION=
# For local development, MINIO_URL_PREFIX will auto-use SERVER_URL

# Backend URL - Local only
SERVER_URL=http://localhost:8080

# Mail (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password_16_chars

# CORS - Frontend URL (Local)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================
# FRONTEND ENVIRONMENT VARIABLES (LOCAL)
# =============================================
# URL gốc của backend - Local development
NEXT_PUBLIC_URL=http://localhost:8080

# API URL - dùng trong chatService.ts và các service khác
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# WebSocket URL - dùng trong chatService.ts để kết nối STOMP/SockJS
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws-chat

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GROQ_API_KEY=gsk_your_groq_api_key
